<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><Nullable>enable</Nullable>
    <AssemblyName>QuestBell</AssemblyName><RootNamespace>QuestBell</RootNamespace>
    <Version>1.5.1</Version><ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/questbell.ico</ApplicationIcon><EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../QuestBell.Core/QuestBell.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <Content Include="Assets/**/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../docs/**/*" Link="Guide/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
